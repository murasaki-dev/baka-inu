# Copy to .env and replace both secrets before starting the container.
ROOM_PORT=8080
ROOM_NAME=Baka-Inu
ROOM_JOIN_CODE=replace-with-a-long-random-neko-password
ROOM_ADMIN_USERNAME=admin
ROOM_ADMIN_PASSWORD=replace-with-a-long-random-password

# Local Docker Desktop testing at http://127.0.0.1:8080: set this to 127.0.0.1.
# Local-only default for testing in this browser on this same machine. For remote
# playback, replace it with a reachable public IP or configure it in the admin panel.
NEKO_WEBRTC_NAT1TO1=127.0.0.1
NEKO_WEBRTC_EPR=52000-52100
# Forward UDP 52000-52100; narrower active ranges can be configured in the admin panel.
NEKO_DESKTOP_SCREEN=1280x720@30
VIRTUAL_DESKTOP_SCREEN=1280x720@30
DESKTOP_SCREEN=1280x720
STREAM_ENCODER=auto
STREAMING_BACKEND=neko

# Required when using compose.vaapi.yaml; get it with:
# stat -c '%g' /dev/dri/renderD128
# GPU_RENDER_GID=992

# Set true only behind a trusted HTTPS reverse proxy. This is the initial default;
# it can also be changed later by the admin in the website.
TRUST_PROXY=false
